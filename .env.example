# KimSafety — environment template. Copy to .env and fill in real values.

# ── Postgres ─────────────────────────────────────────────────────────────
# Local/cPanel: postgresql://user:password@127.0.0.1:5432/dbname
# Neon (Vercel integration): DATABASE_URL is the pooled host; migrations use
# DATABASE_URL_UNPOOLED/DIRECT_URL automatically (also accepts the prefixed
# DATABASE_POSTGRES_URL / DATABASE_POSTGRES_URL_NON_POOLING names, and strips
# the "-pooler" suffix from a neon.tech URL when no direct var is set).
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/dbname
# Optional — only needed when the direct host is not exposed by the integration
# DIRECT_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Optional pg pool cap (defaults: 1 on Vercel, 2 elsewhere)
# DATABASE_POOL_MAX=2

# ── Auth ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Canonical public URL (required by NextAuth v4 on non-Vercel hosts)
NEXTAUTH_URL=https://kimsafety.co.ke
# Optional local/staging override — defaults to https://kimsafety.co.ke
# NEXT_PUBLIC_SITE_URL=

# ── SMTP (invoice, quote, ticket, newsletter email) ──────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="KimSafety <shop@kimsafety.co.ke>"

# ── M-Pesa (Daraja — STK push) ───────────────────────────────────────────
MPESA_ENV=production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Store / Paybill shortcode used as BusinessShortCode
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Buy Goods till (PartyB). When set, STK push uses CustomerBuyGoodsOnline.
# Leave empty for a Paybill.
MPESA_TILL=
MPESA_CALLBACK_URL=https://kimsafety.co.ke/api/payments/mpesa/callback
# Optional — only needed for B2C/initiator flows
# MPESA_INITIATOR=
# MPESA_SECURITY_CREDENTIAL=

# ── Paystack (cards) ─────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=

# ── Cron & digests ───────────────────────────────────────────────────────
# Sent by cPanel cron as: Authorization: Bearer $CRON_SECRET
CRON_SECRET=
DAILY_ORDERS_EMAIL=

# ── Admin bootstrap (used when seeding the first admin) ──────────────────
# ADMIN_EMAIL=admin@kimsafety.co.ke
# ADMIN_PASSWORD=

# ── Analytics (build-time; baked into the client bundle) ─────────────────
# NEXT_PUBLIC_GA_ID=
