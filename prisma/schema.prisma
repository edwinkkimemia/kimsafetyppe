generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Prisma is used purely as the migration runner (`prisma migrate deploy` in
// the build). Application data access goes through src/lib/db.ts (pg driver);
// these models exist only to satisfy the Prisma CLI and do not reflect the
// application schema, which is defined by the raw SQL in prisma/migrations/.
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts     Post[]
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  author    User     @relation(fields: [authorId], references: [id])
  authorId  Int
  createdAt DateTime @default(now())
}
